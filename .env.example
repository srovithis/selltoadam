# .env.example — template for selltoadam.com. Copy to .env.local and fill in.
# Real secrets live in Vercel project env vars (and local .env / .env.local).

# ─── Database (Neon PostgreSQL via Prisma) ────────────────────────────
DATABASE_URL=

# ─── Email / lead notifications ───────────────────────────────────────
SENDGRID_API_KEY=

# ─── STASA AI Chat Widget ─────────────────────────────────────────────
# Anthropic API key for the chat assistant (claude-sonnet-4-6).
ANTHROPIC_API_KEY=

# ntfy.sh topic for handoff push alerts. If unset, defaults in code to
# "selltoadam-leads-adam" (the existing lead-notification topic).
NTFY_TOPIC=

# ─── Twilio (outbound SMS handoff alerts + existing lead SMS) ──────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Destination cell for STASA handoff SMS alerts. Defaults in code to
# +14132622463 if unset.
TWILIO_FORWARD_TO_CELL=+14132622463

# ─── Google Places (address autocomplete) ─────────────────────────────
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
