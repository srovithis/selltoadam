generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id               String      @id @default(cuid())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  address          String
  name             String?
  phone            String?
  email            String?
  soonToSell       String?
  askingPrice      String?
  immediateRepairs String?
  status           String      @default("Lead")
  notes            String?
  followUpDate        DateTime?
  source              String      @default("Website")
  contactPreference   String?
  bestTime            String?
  events              LeadEvent[]
}

model LeadEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  note      String?
}

// ─── STASA AI Chat Widget ───────────────────────────────────────────────────
// Persistent visitor chat sessions for the public site chat widget, plus a
// live human-handoff path (assistant ⇄ staff "Adam").

model StasaVisitor {
  id                 String         @id @default(cuid())
  visitorId          String         @unique
  visitorName        String?
  visitorContact     String?
  handoffRequested   Boolean        @default(false)
  handoffRequestedAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  messages           StasaMessage[]
}

model StasaMessage {
  id        String       @id @default(cuid())
  visitorId String
  visitor   StasaVisitor @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)
  role      String       // "user" | "assistant" | "staff"
  content   String
  createdAt DateTime     @default(now())

  @@index([visitorId, createdAt])
}
